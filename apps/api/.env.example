# MySQL — XAMPP defaults shown. Override in .env.local for non-XAMPP setups.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=medina_dev

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-32-plus-bytes-of-random-hex
JWT_REFRESH_SECRET=replace-me-with-different-32-plus-bytes-of-random-hex
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Server
PORT=4000
NODE_ENV=development

# CORS — origin of apps/web
FRONTEND_ORIGIN=http://localhost:3000
