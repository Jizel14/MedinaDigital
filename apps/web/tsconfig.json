{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "noEmit": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@medina/ui": ["../../libs/ui/src/index.ts"],
      "@medina/ui/*": ["../../libs/ui/src/*"],
      "@medina/product-components": ["../../libs/product-components/src/index.ts"],
      "@medina/product-components/*": ["../../libs/product-components/src/*"],
      "@medina/shared-types": ["../../libs/shared-types/src/index.ts"],
      "@medina/shared-types/*": ["../../libs/shared-types/src/*"],
      "@medina/i18n": ["../../libs/i18n/src/index.ts"],
      "@medina/i18n/*": ["../../libs/i18n/src/*"]
    },
    "allowJs": true
  },
  "include": [
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "node_modules/.cache/next-medina/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", "dist"]
}
