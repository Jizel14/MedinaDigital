{
  "name": "@medina/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "scope:web"
    ]
  },
  "scripts": {
    "dev": "next dev",
    "dev:clean": "node -e \"require('fs').rmSync('node_modules/.cache/next-medina', { recursive: true, force: true }); console.log('cache cleared')\" && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@medina/i18n": "workspace:*",
    "@medina/product-components": "workspace:*",
    "@medina/shared-types": "workspace:*",
    "@medina/ui": "workspace:*",
    "@use-gesture/react": "^10.3.1",
    "motion": "^11.15.0",
    "next": "^15.1.6",
    "next-intl": "^4.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  }
}
